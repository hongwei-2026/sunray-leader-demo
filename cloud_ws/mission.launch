<launch>
  <arg name="use_mock" default="true"/>
  <arg name="mission_file" default="$(find sunray_mission)/config/mission.yaml"/>
  <arg name="rviz" default="true"/>

  <node if="$(arg use_mock)" pkg="sunray_mission" type="mock_uav.py" name="mock_uav" output="screen">
    <param name="uav_id" value="1"/>
    <param name="uav_name" value="uav"/>
    <param name="takeoff_height" value="1.2"/>
  </node>

  <node pkg="sunray_mission" type="mission_node.py" name="mission_node" output="screen">
    <rosparam file="$(arg mission_file)" command="load"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find sunray_mission)/rviz/mission.rviz"/>
</launch>
